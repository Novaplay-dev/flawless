# User service for the Flawless dictation daemon.
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/flawless.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now flawless
[Unit]
Description=Flawless voice dictation daemon
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/flawless/.venv/bin/flawless daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
